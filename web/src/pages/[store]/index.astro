---
import BlockList from '../../components/BlockList.jsx';
import Dashboard from '../../components/Dashboard.jsx';
import Shell from '../../layouts/Shell.astro';
import { blockReading } from '../../lib/blocks.mjs';
import { storeTotals } from '../../lib/not-checked.mjs';
import {
  loadExtracts, loadSeedRows, loadSummaries, notCheckedFor, regionsChangedInLog,
  regionsRemovedInStore, storesInLog,
} from '../../lib/reports.mjs';
import { flattenedPages } from '../../lib/flattening.mjs';
import { siblingOf } from '../../lib/language-blocks.mjs';
import { STORE_NAME } from '../../lib/stores.mjs';

// One dashboard per store. The page-level route already carried the store; this
// was the one route that did not, so a link to the French dashboard could not be
// sent to a colleague (ticket 38).
export async function getStaticPaths() {
  const stores = await storesInLog();
  return stores.map((store) => ({ params: { store } }));
}

const { store } = Astro.params;

// This store's summaries, and the sibling's where this store is in a language block.
// The build still reads no *third* store's reports, so the visitor who opens `de`
// downloads 45 pages and not 451 — `de` and `uk` are in no block and pay nothing.
//
// The second read is ticket 03's price, and it is the price of the press and not of the
// panel: a block-spanning dismissal is decided in the browser, so the sibling's findings
// have to be *there*, unlike the block reading below, which is worked out at build time
// and ships no units at all. ADR 0018 records the number.
const pages = await loadSummaries(store);
const notChecked = await notCheckedFor(store, pages);
const regions = regionsRemovedInStore(pages);

// Ticket 64: about the whole run, and not about this store. The banner anchor is
// campaign-specific, so the day it stops matching must be one line here and not
// 2,600 rows that came back.
const regionsChanged = await regionsChangedInLog();

// The found total is stated beside the store, and since ticket 04 the sentence below is
// the **only** place the compared count is stated: the dashboard drew it again as a chip
// over the queue, which is a census where an editor is looking for work. This sentence
// carries the whole arithmetic — found, crawled, comparable — so the chip was the
// duplicate half of it and not the fact.
// On nl the gap is 179 to 124. Nobody reads 124 as the size of the store. On fr
// the gap is 28 to 25. A reader who arrives through the switcher does read 25 as
// the size of the store.
//
// `storeTotals()` does the arithmetic, so the one number two people can quote
// and mean different things by has a test (ticket 56).
const totals = storeTotals({ pages, notChecked });

// The language block, where this store is in one. `null` on `de` and `uk`, and the
// panel then draws nothing at all rather than drawing itself empty.
//
// It is decided here, at build time, and handed over as a value: the panel below
// ships no JavaScript, and the browser downloads neither store's content units. The
// sibling's reports are read only where there is a sibling, so `de` and `uk` pay
// nothing for a feature they do not have.
const sibling = siblingOf(store);

// The sibling's summaries, for the repeat grouping and for nothing else on this screen.
// Empty where there is no sibling, which is what makes the widening cost `de` and `uk`
// exactly nothing rather than costing them a branch.
const siblingPages = sibling ? await loadSummaries(sibling) : [];

/*
 * Both stores of the block, **both sides**, read once for the whole dashboard.
 *
 * Production is what the agreement share is measured over, and the new site is what the
 * flattening needs: a store difference production had and the new site has not is a
 * statement about all four extracts of a page pair. It is one read of the reports and one
 * peak in memory, at build time, on two stores — `de` and `uk` are in no block and pay
 * nothing, as they pay nothing for the panel itself.
 *
 * None of it is shipped. The panel below renders on the server, so what reaches the
 * browser is the reading: a share, a count and a page key.
 */
const extractsByStore = new Map(
  await Promise.all(
    (sibling ? [store, sibling] : []).map(
      async (one) => /** @type {const} */ ([one, await loadExtracts(one)]),
    ),
  ),
);
const sidesOf = (one, page) => extractsByStore.get(one)?.get(page) ?? null;

const seeds = await loadSeedRows();
// What the migration flattened, per page of this store (ticket 07). It orders the list
// below, and it is the same `flattenedUnits()` the page's sibling tab draws — so no page
// is lifted for a reason the tab it lifts to does not show.
const flattening = flattenedPages({ rows: seeds, store, sidesOf });

const block = blockReading({
  rows: seeds,
  store,
  unitsOf: (one, page) => sidesOf(one, page)?.production?.map((unit) => unit.norm) ?? null,
  flatteningOn: (page) => flattening.get(page) ?? 0,
});
---

<Shell title={`Dashboard — ${store}`} store={store}>
  <header slot="banner">
    <h1 class="text-xl font-semibold">Parity with production</h1>
    <p class="text-sm text-muted-foreground">
      Production is the source of truth, so each difference is a defect on the
      new site. Store: <strong>{store}</strong> — {STORE_NAME[store]}.
    </p>
    <p class="text-sm text-muted-foreground">
      <strong>{totals.found}</strong> pages found: {totals.crawled} crawled, of which {totals.comparable} can be
      compared.{
        totals.oneSided > 0 && ` The other ${totals.oneSided} are one-sided: the new site does not answer 200 there. They are at the bottom.`
      }{
        totals.notChecked > 0 && ` ${totals.notChecked} pages are not checked; the bottom of this page says why, for each one.`
      }
    </p>
  </header>
  <Dashboard
    client:load
    store={store}
    pages={pages}
    siblingPages={siblingPages}
    notChecked={notChecked}
    regions={regions}
    regionsChanged={regionsChanged}
  />
  <BlockList reading={block} />
</Shell>
