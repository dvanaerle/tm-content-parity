---
import PageView from '../../components/PageView.jsx';
import Shell from '../../layouts/Shell.astro';
import { loadReports } from '../../lib/reports.mjs';
import { CHROME, PILL } from '../../lib/palette.mjs';

// One real HTML page per store page. The tabs are an island inside it. A page key
// that holds a slash renders through this rest route, verified by ticket 08.
export async function getStaticPaths() {
  const reports = await loadReports();
  return reports.map((report) => ({
    params: { store: report.store, page: report.page },
    props: { report },
  }));
}

const { report } = Astro.props;
const { production, new: next } = report.sides;
---

<Shell title={`${report.store} — ${report.page}`}>
  <header class="mb-4">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-xl font-semibold">{report.page}</h1>
      <a class={`text-sm hover:underline ${CHROME.link}`} href={production.url} rel="noreferrer">productie ↗</a>
      <a class={`text-sm hover:underline ${CHROME.link}`} href={next.url} rel="noreferrer">nieuw ↗</a>
      <a class={`ml-auto text-sm hover:underline ${CHROME.link}`} href="/">← alle pagina's</a>
    </div>

    {/* The two count chips are gone: the bar in the island replaces them, because
        a count that ignores the overrides contradicts the one beside it. */}
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded bg-slate-100 px-2 py-1 text-slate-600">
        productie <strong>{production.status}</strong> · {production.elements.length} elementen
      </span>
      <span class="rounded bg-slate-100 px-2 py-1 text-slate-600">
        nieuw <strong>{next.status}</strong> · {next.elements.length} elementen
      </span>
      {
        (production.boundary !== 'main' || next.boundary !== 'main') && (
          <span class={`rounded px-2 py-1 ${PILL.attention}`}>
            grens: productie {production.boundary}, nieuw {next.boundary}
          </span>
        )
      }
    </div>
  </header>

  <PageView client:load report={report} />
</Shell>
