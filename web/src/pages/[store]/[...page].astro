---
import PageBreadcrumb from '../../components/PageBreadcrumb.jsx';
import PageView from '../../components/PageView.jsx';
import Shell from '../../layouts/Shell.astro';
import { Badge } from '../../components/ui/badge.jsx';
import { loadProductionExtracts, loadReports, loadSeedRows } from '../../lib/reports.mjs';
import { closingsFor, firstSeenOn, loadClosings, loadFirstSeen } from '../../lib/run-log.mjs';
import { siblingPages } from '../../lib/blocks.mjs';
import { siblingOf } from '../../lib/language-blocks.mjs';
import { CHROME } from '../../lib/palette.mjs';

// One real HTML page per store page. The tabs are an island inside it. A page key
// that holds a slash renders through this rest route, verified by ticket 08.
export async function getStaticPaths() {
  const reports = await loadReports();

  /*
   * The sibling page of each page, and the sibling's production extract (ticket 04).
   *
   * Matched here, at build time, from the seed list — the same `siblingPages()` the
   * dashboard's block list is built from, so the two screens cannot disagree about which
   * page is whose sibling or about which rule matched it.
   *
   * Read **once per store** and not once per page: the match is over the whole seed list
   * either way, and a per-page read would parse the sibling store's reports 181 times.
   *
   * `de` and `uk` are in no block, so nothing here runs for them and their pages carry
   * no sibling at all. What a block store's page does carry is one more extract in its
   * props — production's, from the other store. That is the price of comparing two pages
   * on one screen and there is no cheaper form of it; only production is shipped, and
   * only for the one sibling page.
   */
  // The run log, read once for the whole build and narrowed per page. It is the one
  // artefact here that outlives a run: the reports say what the sites hold now, and this
  // says since when (ticket 77).
  const seenIndex = await loadFirstSeen();
  // The second reading of the same index (ticket 78): which ids stopped being seen in the
  // run that first saw each of this page's findings. It says nothing about what an editor
  // decided about them — that arrives with the override log, in the browser.
  const closings = await loadClosings();

  const seeds = await loadSeedRows();
  /** @type {Map<string, Map<string, { page: string, rule: string }>>} */
  const matched = new Map();
  /** @type {Map<string, Map<string, import('../../../compare/contract.mjs').ContentUnit[]>>} */
  const extracts = new Map();

  for (const store of new Set(reports.map((report) => report.store))) {
    const other = siblingOf(store);
    if (!other) continue;

    matched.set(
      store,
      new Map(
        siblingPages({ rows: seeds, store })
          .filter((one) => one.sibling)
          .map((one) => [one.page, one.sibling]),
      ),
    );
    if (!extracts.has(other)) extracts.set(other, await loadProductionExtracts(other));
  }

  return reports.map((report) => {
    const other = siblingOf(report.store);
    const match = matched.get(report.store)?.get(report.page) ?? null;

    return {
      params: { store: report.store, page: report.page },
      props: {
        report,
        firstSeen: firstSeenOn(seenIndex, report.findings),
        closedWith: closingsFor(closings, report.findings),
        // `units` is null where the sibling page has no production report. The reading
        // calls that unmeasured, in the block list's own word: nothing was compared, and
        // that is a different fact from finding nothing.
        sibling: match
          ? {
              store: other,
              page: match.page,
              rule: match.rule,
              units: extracts.get(other)?.get(match.page) ?? null,
            }
          : null,
      },
    };
  });
}

const { report, sibling, firstSeen, closedWith } = Astro.props;
const { production, new: next } = report.sides;
---

<Shell title={`${report.store} — ${report.page}`} store={report.store}>
  <header slot="banner">
    <!-- Where this page sits, and the way back out of it (ticket 109). It replaces the
         lone *← all pages of nl* link, which pointed at the bare store and so threw
         away the pills, the view and the search term. It is a `client:load` island only
         because the screen it returns to arrives in the address bar; it renders the bare
         store link at build time, so a reader with no JavaScript keeps the link that was
         here before. -->
    <PageBreadcrumb client:load store={report.store} page={report.page} />

    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-xl font-semibold">{report.page}</h1>
      <a class={`text-sm hover:underline ${CHROME.link}`} href={production.url} rel="noreferrer">production ↗</a>
      <a class={`text-sm hover:underline ${CHROME.link}`} href={next.url} rel="noreferrer">new ↗</a>
    </div>

    {/* The two count chips are gone: the bar in the island replaces them, because
        a count that ignores the overrides contradicts the one beside it. */}
    {/* `Badge` with no `client:` directive. Astro renders a React component to static
        HTML at build time unless one is given, so these three chips get the shadcn
        shape and ship no JavaScript at all — which is what the rest of this header
        already does. */}
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
      <Badge variant="outline" className="h-auto gap-1 px-2 py-1">
        production <strong>{production.status}</strong> · {production.elements.length} blocks
      </Badge>
      <Badge variant="outline" className="h-auto gap-1 px-2 py-1">
        new <strong>{next.status}</strong> · {next.elements.length} blocks
      </Badge>
      {
        (production.boundary !== 'main' || next.boundary !== 'main') && (
          <Badge variant={null} data-wears="pill" data-tone="caution" className="h-auto px-2 py-1">
            boundary: production {production.boundary}, new {next.boundary}
          </Badge>
        )
      }
    </div>
  </header>

  <PageView client:load report={report} sibling={sibling} firstSeen={firstSeen} closedWith={closedWith} />
</Shell>
