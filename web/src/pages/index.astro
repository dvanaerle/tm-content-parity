---
import Dashboard from '../components/Dashboard.jsx';
import Shell from '../layouts/Shell.astro';
import { excluded, loadSummaries } from '../lib/reports.mjs';

const pages = await loadSummaries();
const stores = [...new Set(pages.map((page) => page.store))];
---

<Shell title="Overzicht">
  {
    pages.length === 0 ? (
      <p class="text-slate-600">
        Nog geen rapporten in <code>data/reports/</code>. Draai
        <code>node crawl/21-crawl-store.mjs nl</code> en daarna
        <code>node compare/30-compare.mjs nl</code>.
      </p>
    ) : (
      <>
        <header class="mb-4">
          <h1 class="text-xl font-semibold">Pariteit met productie</h1>
          <p class="text-sm text-slate-600">
            Productie is de bron van waarheid, dus elk verschil is een defect op de
            nieuwe site. Winkel{stores.length > 1 ? 's' : ''}: {stores.join(', ')}.
          </p>
        </header>
        <Dashboard client:load pages={pages} excluded={excluded} />
      </>
    )
  }
</Shell>
