---
import Shell from '../layouts/Shell.astro';
import { storesInLog } from '../lib/reports.mjs';
import { CHROME } from '../lib/palette.mjs';
import { STORE_NAME } from '../lib/stores.mjs';

// There is no all-stores dashboard. A store is what an editor is responsible for,
// and six stores of summaries on one screen is what ticket 38 removes.
//
// So the root lists the stores and waits. It moves nobody on. An earlier version
// carried a meta refresh to the first store: the list was then never readable, and
// back from a dashboard landed here and was pushed forward again.
const stores = await storesInLog();
---

<Shell title="Stores">
  {
    stores.length === 0 ? (
      <p class="text-muted-foreground">
        No reports in <code>data/reports/</code> yet. Run
        <code>node crawl/21-crawl-store.mjs nl</code> and then
        <code>node compare/30-compare.mjs nl</code>.
      </p>
    ) : (
      <section>
        <h1 class="mb-2 text-xl font-semibold">Choose a store</h1>
        <p class="mb-4 text-sm text-muted-foreground">
          Each store has its own dashboard and its own progress.
        </p>
        <ul class="space-y-1 text-sm">
          {stores.map((store) => (
            <li>
              <a class={`font-medium hover:underline ${CHROME.link}`} href={`/${store}/`}>{store}</a>
              <span class="text-muted-foreground"> — {STORE_NAME[store]}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Shell>
