---
import Shell from '../layouts/Shell.astro';
import { storesInLog } from '../lib/reports.mjs';
import { CHROME } from '../lib/palette.mjs';
import { STORE_NAME } from '../lib/stores.mjs';

// There is no all-stores dashboard: a store is what an editor is responsible for,
// and six stores of summaries on one screen is what ticket 38 removes. So the
// root is a doorway to the first store, and nothing more.
//
// It is a page and not `Astro.redirect`, for two reasons. A static redirect is a
// meta-refresh page too, but it is generated in English with a two-second delay,
// and the interface is Dutch on every store. And a doorway that lists the stores
// is what a reader who arrived on a stale bookmark needs to see.
const stores = await storesInLog();
const first = stores[0];
---

<Shell title="Winkels">
  {first && <meta slot="head" http-equiv="refresh" content={`0;url=/${first}/`} />}
  {
    stores.length === 0 ? (
      <p class="text-slate-600">
        Nog geen rapporten in <code>data/reports/</code>. Draai
        <code>node crawl/21-crawl-store.mjs nl</code> en daarna
        <code>node compare/30-compare.mjs nl</code>.
      </p>
    ) : (
      <>
        <h1 class="mb-2 text-xl font-semibold">Kies een winkel</h1>
        <p class="mb-4 text-sm text-slate-600">Je gaat door naar {first}.</p>
        <ul class="space-y-1 text-sm">
          {stores.map((store) => (
            <li>
              <a class={`font-medium hover:underline ${CHROME.link}`} href={`/${store}/`}>{store}</a>
              <span class="text-slate-500"> — {STORE_NAME[store]}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Shell>
