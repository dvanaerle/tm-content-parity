---
import '../styles/app.css';
import BrandLogo from '../components/BrandLogo.astro';
import StoreSwitcher from '../components/StoreSwitcher.astro';
import { CHROME } from '../lib/palette.mjs';
import { storesInLog } from '../lib/reports.mjs';

const { title, store } = Astro.props;

// The switcher belongs to the shell, so every page carries it and the store is
// never something the reader has to go back to the dashboard to change.
const stores = await storesInLog();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} — Content parity log</title>
    <slot name="head" />
  </head>
  <body>
    {/*
      The one place brand colour is spent in the shell. Ticket 35: the header
      says "this is a Tuinmaximaal tool" and nothing about a finding, so the
      brand green stops at the bottom border of this element. The colours come
      from `CHROME`, because a literal here is a second place to change one.
    */}
    {/*
      Colour is full-bleed; the row is not. `container` is the one width the
      chrome, the surface banner and the page share, so they line up. The bar
      itself stays `h-16`, so it takes the same inset horizontally (`px-4
      sm:px-6`) and none of the vertical padding the page uses. The inset still
      gives way before the switcher does: six store pills and a logo are a
      fixed cost in a fixed-height bar — nothing here can wrap without breaking
      the `h-16`.
    */}
    <header class={`h-16 ${CHROME.header}`}>
      <div class="container mx-auto flex h-16 items-center px-4 sm:px-6">
        <a href={store ? `/${store}/` : '/'} aria-label="Content parity log" class="inline-block">
          <BrandLogo />
        </a>
        <StoreSwitcher stores={stores} store={store} />
      </div>
    </header>
    {/*
      `bg-surface` paints the viewport; the words sit in the same container as
      the chrome. Pages that need the band pass `slot="banner"`. Pages that
      don't, don't — wrapping the default slot would have clipped the colour.
    */}
    {Astro.slots.has('banner') && (
      <div class="bg-surface">
        <div class="container mx-auto p-4 md:py-6 lg:py-10">
          <slot name="banner" />
        </div>
      </div>
    )}
    <main class="container mx-auto p-4 md:py-6">
      <slot />
    </main>
  </body>
</html>
