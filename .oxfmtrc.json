{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/*.md",
    "**/*.markdown",
    "**/*.mdx",
    "data/**",
    "package-lock.json",
    "web/package-lock.json"
  ],
  "singleQuote": true,
  "sortTailwindcss": {
    "stylesheet": "./web/src/styles/app.css",
    "functions": ["cn", "cva", "clsx"]
  }
}
