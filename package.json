{
  "name": "tm-content-parity",
  "version": "0.1.0",
  "private": true,
  "description": "Content parity log for the Tuinmaximaal storefront: crawl, compare, and report the differences between production and the new Hyva site.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "compare": "node compare/30-compare.mjs",
    "build": "npm --prefix web run build",
    "build:ci": "npm --prefix web ci && npm --prefix web run build",
    "deploy": "npm run build && wrangler deploy",
    "serve": "node api/server.mjs",
    "start": "npm run build && npm run serve",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "node-html-parser": "^9.0.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^3.2.7",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.121.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
